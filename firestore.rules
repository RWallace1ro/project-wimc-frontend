rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── User data ────────────────────────────────────────────────────────────
    // Each user's profile doc and EVERYTHING under it (incl. the syncdata
    // subcollection) is private to that authenticated user only.
    //
    // Fields the SERVER owns: the user's paid tier and subscription state, and
    // the AI-cap bypass flag. These live on the same doc the user can otherwise
    // edit, so without this guard any signed-in user could open the browser
    // console and write `tier: "pro_ai"` (free paid features) or
    // `aiUnlimited: true` (uncapped Anthropic spend) onto their own account.
    // Only the Admin SDK (Stripe/RevenueCat webhooks, syncEffectiveTier) may
    // touch these — the Admin SDK bypasses rules, so nothing server-side needs
    // an exception.
    function serverOwnedKeys() {
      return ['tier', 'stripeTier', 'appleTier', 'aiUnlimited',
              'subscriptionStatus', 'subscriptionUpdatedAt', 'currentPeriodEnd',
              'stripeCustomerId', 'stripeSubscriptionId', 'stripePriceId',
              'appleSubscriptionStatus', 'appleProductId', 'appleExpiresAt',
              'appleSubscriptionUpdatedAt'];
    }

    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;

      // Signup writes the profile (userName/email/avatarUrl/createdAt) — it may
      // not seed any server-owned field.
      allow create: if request.auth != null && request.auth.uid == userId
                    && !request.resource.data.keys().hasAny(serverOwnedKeys());

      // Profile edits / scheduled-deletion flags are fine; changing (or
      // removing) any server-owned field is not.
      allow update: if request.auth != null && request.auth.uid == userId
                    && !request.resource.data.diff(resource.data)
                         .affectedKeys().hasAny(serverOwnedKeys());

      allow delete: if request.auth != null && request.auth.uid == userId;

      // Subcollections (syncdata, etc.). Deliberately requires at least one
      // path segment ({sub}) — under rules_version 2 a bare `/{document=**}`
      // ALSO matches the user doc itself and would silently re-grant full
      // write there, defeating the guard above.
      match /{sub}/{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // ── Shared / collaborative content ───────────────────────────────────────
    // Public shareable links (outfits, wish lists, shopping lists, etc.).
    match /sharedContent/{docId} {
      // Anyone with the link can VIEW (the /shared route is public)
      allow read: if true;

      // Only a signed-in user can create a share, and they must stamp
      // themselves as the owner. Payload must match the exact shape written
      // by createCollabDoc (shareUtils.js) with sane size limits.
      allow create: if request.auth != null
                    && request.resource.data.ownerId == request.auth.uid
                    && request.resource.data.keys().hasOnly(
                         ['type', 'data', 'ownerId', 'ownerName',
                          'createdAt', 'anyoneCanEdit', 'checkedItems', 'comments'])
                    && request.resource.data.type is string
                    && request.resource.data.type.size() <= 50
                    && request.resource.data.ownerName is string
                    && request.resource.data.ownerName.size() <= 100
                    && request.resource.data.createdAt is string
                    && request.resource.data.createdAt.size() <= 40
                    && request.resource.data.anyoneCanEdit is bool
                    && request.resource.data.checkedItems is map
                    && request.resource.data.checkedItems.size() == 0
                    && request.resource.data.comments is map
                    && request.resource.data.comments.size() == 0;

      // Collaborative editing is limited to toggling checkboxes (checkedItems)
      // and leaving per-item notes/suggestions (comments), and only when the
      // share opted in via anyoneCanEdit. No other field can be altered by a
      // recipient.
      allow update: if resource.data.anyoneCanEdit == true
                    && request.resource.data.diff(resource.data)
                         .affectedKeys().hasOnly(['checkedItems', 'comments']);

      // Only the original owner can delete their share.
      allow delete: if request.auth != null
                    && request.auth.uid == resource.data.ownerId;
    }

    // ── Default deny ─────────────────────────────────────────────────────────
    // Anything not explicitly matched above is denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
